{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "projects.html", "use": "@vercel/static" },
    { "src": "services.html", "use": "@vercel/static" },
    { "src": "journal.html", "use": "@vercel/static" },
    { "src": "admin.html", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "CLIENTS/**", "use": "@vercel/static" },
    { "src": "Hero moving images/**", "use": "@vercel/static" },
    { 
      "src": "api/index.js", 
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["*.html", "data/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1",
      "headers": { "cache-control": "s-maxage=31536000, immutable" }
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/index(.html)?",
      "status": 308,
      "headers": { "Location": "/" }
    },
    {
      "src": "/projects.html",
      "status": 308,
      "headers": { "Location": "/projects" }
    },
    {
      "src": "/services.html",
      "status": 308,
      "headers": { "Location": "/services" }
    },
    {
      "src": "/journal.html",
      "status": 308,
      "headers": { "Location": "/journal" }
    },
    {
      "src": "/admin.html",
      "status": 308,
      "headers": { "Location": "/admin" }
    },
    {
      "src": "/project/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/case-study/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/projects",
      "dest": "/api/index.js"
    },
    {
      "src": "/services",
      "dest": "/services.html"
    },
    {
      "src": "/journal/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/journal",
      "dest": "/api/index.js"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
